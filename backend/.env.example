# ──────────────────────────────────────────────────────────────────────────────
# MDF Backend – Environment Variables Template
# Salin file ini ke .env lalu isi nilainya. JANGAN commit .env ke repository!
# ──────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/mdf_db?sslmode=require

# ── JWT Authentication ────────────────────────────────────────────────────────
# Gunakan string acak minimal 64 karakter. Generate dengan:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=ganti_dengan_string_acak_minimal_64_karakter
JWT_EXPIRES_IN=8h

# ── CORS – Whitelist Origin (pisahkan dengan koma, tanpa spasi) ───────────────
# Contoh IP pabrik atau domain production:
#   http://192.168.3.77  atau  https://mdf.pabrik.com
# JANGAN gunakan wildcard (*) di production!
ALLOWED_ORIGINS=http://192.168.3.77,http://192.168.3.77:5000
